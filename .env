# Local configuration for the bank extractor pipeline.
# Edit HF_MODEL_NAME_OR_PATH to test a different local Hugging Face model.

PDF_PATH=final_report_merged.pdf
# HF_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-14B-Instruct
HF_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-3B-Instruct
# HF_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-7B-Instruct

# HF_MODEL_NAME_OR_PATH=Qwen/Qwen3-8B

# HF_MODEL_NAME_OR_PATH=deepseek-ai/DeepSeek-R1-Distill-Qwen-14B
HF_MODEL_CLASS=causal
HF_LOCAL_FILES_ONLY=false
HF_TRUST_REMOTE_CODE=false
HF_LOAD_IN_4BIT=true
HF_LOAD_IN_8BIT=false
HF_DEVICE_MAP=auto
HF_TORCH_DTYPE=float16
# NOTE: 02_extract_fields.py auto-raises this to 2200 if set lower (a
# single 56-field JSON needs ~2200 tokens of budget). It's left at 1200
# here for backward compatibility if you ever run 02 directly again.
# The hybrid pipeline (03) doesn't need 2200 per call since each group
# call only returns a handful of fields -- see RAG_GROUP_MAX_NEW_TOKENS
# below for its own, smaller budget.
HF_MAX_NEW_TOKENS=1200
HF_TEMPERATURE=0.0
HF_TOP_P=1.0
HF_REPETITION_PENALTY=1.03
TEXT_CHUNK_SIZE=3000
PRODUCTS_DIR=products
INDEX_PATH=products_index.json
OUT_JSONL=extracted_data.jsonl
OUT_XLSX=bank_products_extracted.xlsx
REGENERATE_STAGE1=

# ---------------------------------------------------------------------------
# Hybrid RAG upgrade (03_extract_fields_hybrid.py / hybrid_rag/ package)
# ---------------------------------------------------------------------------
# Token chunking (replaces TEXT_CHUNK_SIZE for the hybrid path)
RAG_TARGET_TOKENS=850
RAG_OVERLAP_TOKENS=150

# Hybrid retrieval
RAG_TOP_K=6
RAG_ALPHA=0.5

# Ensemble passes per field group. 1 = fastest/cheapest (default). Set to
# 2 or 3 to get genuine majority-vote merging via hybrid_rag/merge_strategy.py
# (costs proportionally more LLM calls).
RAG_ENSEMBLE_PASSES=1

# Embedding model for FAISS. Falls back automatically to TF-IDF
# (scikit-learn) then a zero-dependency hashing embedder if this can't be
# downloaded/loaded.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# true writes extracted_data.debug.jsonl with confidence/evidence/
# chunk_id/page per field, alongside the normal OUT_JSONL output.
EXTRACTION_DEBUG_MODE=false
