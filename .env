# Local configuration for the bank extractor pipeline.
# Edit HF_MODEL_NAME_OR_PATH to test a different local Hugging Face model.

PDF_PATH=final_report_merged.pdf
HF_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-14B-Instruct
HF_MODEL_CLASS=causal
HF_LOCAL_FILES_ONLY=false
HF_TRUST_REMOTE_CODE=false
HF_MAX_NEW_TOKENS=1200
HF_TEMPERATURE=0.0
HF_TOP_P=1.0
HF_REPETITION_PENALTY=1.03
TEXT_CHUNK_SIZE=15000
PRODUCTS_DIR=products
INDEX_PATH=products_index.json
OUT_JSONL=extracted_data.jsonl
OUT_XLSX=bank_products_extracted.xlsx
REGENERATE_STAGE1=false
