# Copy this file to .env and edit the values you want to test.

# Only needed if you want to regenerate the product chunks from the PDF.
PDF_PATH=final_report_merged.pdf

# Local Hugging Face model, either a cached model ID or a local folder path.
# Examples:
# HF_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-3B-Instruct
# HF_MODEL_NAME_OR_PATH=meta-llama/Llama-3.2-3B-Instruct
# HF_MODEL_NAME_OR_PATH=D:/models/qwen2.5-3b-instruct
HF_MODEL_NAME_OR_PATH=

# causal = AutoModelForCausalLM, seq2seq = AutoModelForSeq2SeqLM
HF_MODEL_CLASS=causal

# Keep true if you want offline-only loading from local cache or local folders.
HF_LOCAL_FILES_ONLY=true

# Some models need this. Keep false unless your model README says otherwise.
HF_TRUST_REMOTE_CODE=false

# Generation settings for extraction.
HF_MAX_NEW_TOKENS=1200
HF_TEMPERATURE=0.0
HF_TOP_P=1.0
HF_REPETITION_PENALTY=1.03

# How many characters of each product file to send to the model.
TEXT_CHUNK_SIZE=15000

# Optional overrides for output files.
PRODUCTS_DIR=products
INDEX_PATH=products_index.json
OUT_JSONL=extracted_data.jsonl
OUT_XLSX=bank_products_extracted.xlsx
